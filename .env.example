# Copy to .env and fill in. Never commit .env.

# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (letters, digits, - and _ only: avoid $ and # which .env files can misread)
SECRET_KEY=

# True only on your own computer. Must be False in production.
DEBUG=True

# Comma-separated host names the app may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: full origins, e.g. https://app.example.com
CSRF_TRUSTED_ORIGINS=

# Leave unset to use the local SQLite file (db.sqlite3).
# Production example: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Uploads
MAX_UPLOAD_MB=5
# MEDIA_ROOT=/absolute/path/to/persistent/media

# Login session length in hours
SESSION_HOURS=12

# Production-only security switches (ignored when DEBUG=True)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=False
